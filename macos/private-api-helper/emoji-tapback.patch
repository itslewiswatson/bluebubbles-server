+// Returns a copy of text that the non-keyed NSArchiver can encode, or text itself if it already can.
+// Messages with data detector results (addresses, dates, phone numbers, links) carry DDScannerResult
+// attributes, which only support keyed coding. IMMessagePartChatItem's messageSummaryInfo archives the
+// part text with NSArchiver, so they make it throw and take Messages.app down with it.
++(NSAttributedString *) archivableTapbackText:(NSAttributedString *)text {
+    if (text == nil) return nil;
+
+    BOOL (^canArchive)(NSAttributedString *) = ^BOOL(NSAttributedString *t) {
+        @try {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+            return [NSArchiver archivedDataWithRootObject:t] != nil;
+#pragma clang diagnostic pop
+        } @catch (NSException *exception) {
+            return NO;
+        }
+    };
+    if (canArchive(text)) return text;
+
+    Class ddResultClass = NSClassFromString(@"DDScannerResult");
+    BOOL (^isDDValue)(id) = ^BOOL(id value) {
+        if (ddResultClass == nil) return NO;
+        if ([value isKindOfClass:ddResultClass]) return YES;
+        if ([value isKindOfClass:[NSArray class]]) {
+            for (id v in (NSArray *)value) {
+                if ([v isKindOfClass:ddResultClass]) return YES;
+            }
+        }
+        return NO;
+    };
+
+    NSMutableAttributedString *stripped = [text mutableCopy];
+    [text enumerateAttributesInRange:NSMakeRange(0, text.length) options:0 usingBlock:^(NSDictionary *attrs, NSRange range, BOOL *stop) {
+        for (NSString *key in attrs) {
+            if (isDDValue(attrs[key]) || [key isEqualToString:@"__kIMDataDetectedAttributeName"] || [key isEqualToString:@"__kIMDataDetectorResultAttributeName"]) {
+                [stripped removeAttribute:key range:range];
+            }
+        }
+    }];
+    if (canArchive(stripped)) return stripped;
+
+    // Still not archivable, so keep only the message part attribute the tapback needs
+    NSMutableAttributedString *plain = [[NSMutableAttributedString alloc] initWithString:text.string];
+    [text enumerateAttribute:@"__kIMMessagePartAttributeName" inRange:NSMakeRange(0, text.length) options:0 usingBlock:^(id value, NSRange range, BOOL *stop) {
+        if (value != nil) [plain addAttribute:@"__kIMMessagePartAttributeName" value:value range:range];
+    }];
+    return plain;
+}
