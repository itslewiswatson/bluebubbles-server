+// Send an emoji tapback (macOS 15+). reactionType is "emoji" or "-emoji", and reactionEmoji is any emoji
++(void) sendEmojiTapback:(NSDictionary *)data chat:(IMChat *)chat message:(IMMessage *)message item:(IMMessagePartChatItem *)item transaction:(NSString *)transaction {
+    void (^sendError)(NSString *) = ^(NSString *error) {
+        DLog("BLUEBUBBLESHELPER: %{public}@", error);
+        if (transaction != nil) {
+            [[NetworkController sharedInstance] sendMessage: @{@"transactionId": transaction, @"error": error}];
+        }
+    };
+
+    @try {
+        NSString *emoji = data[@"reactionEmoji"];
+        if (![emoji isKindOfClass:[NSString class]] || [emoji length] == 0) {
+            sendError(@"No reactionEmoji provided for emoji tapback!");
+            return;
+        }
+
+        Class tapbackClass = NSClassFromString(@"IMEmojiTapback");
+        if (tapbackClass == nil) {
+            sendError(@"Emoji tapbacks require macOS 15 or newer!");
+            return;
+        }
+
+        BOOL isRemoved = [data[@"reactionType"] hasPrefix:@"-"];
+        id<BBEmojiTapback> tapback = [[tapbackClass alloc] initWithEmoji:emoji isRemoved:isRemoved];
+
+        // IMTapbackSender builds its summary from the chat item's text, so make sure it can be archived.
+        // The item comes from _newChatItems, so it's our own copy and not one the transcript is showing.
+        if (item != nil && [item text] != nil) {
+            NSAttributedString *safeText = [BlueBubblesHelper archivableTapbackText:[item text]];
+            Ivar textIvar = class_getInstanceVariable([IMMessagePartChatItem class], "_text");
+            if (safeText != [item text] && textIvar != NULL) {
+                object_setIvar(item, textIvar, safeText);
+            }
+        }
+
+        // Prefer IMTapbackSender, which is what Messages.app uses to send tapbacks
+        BOOL sent = NO;
+        Class senderClass = NSClassFromString(@"IMTapbackSender");
+        if (item != nil && senderClass != nil) {
+            @try {
+                id<BBTapbackSender> sender = [[senderClass alloc] initWithTapback:tapback chat:chat messagePartChatItem:item];
+                if (sender != nil) {
+                    [sender send];
+                    sent = YES;
+                }
+            } @catch (NSException *exception) {
+                DLog("BLUEBUBBLESHELPER: IMTapbackSender failed, falling back to a plain text summary: %{public}@", exception.reason);
+            }
+        }
+
+        if (!sent) {
+            if (![tapback respondsToSelector:@selector(messageForChat:messageGUID:messagePartRange:messageSummaryInfo:threadIdentifier:)]) {
+                sendError(@"Emoji tapbacks are not supported on this macOS version!");
+                return;
+            }
+            // Build the tapback message ourselves, mirroring how classic tapbacks are associated.
+            // The summary only uses the plain string, so nothing needs archiving.
+            NSAttributedString *text = (item != nil && [item text] != nil) ? [item text] : [message text];
+            NSString *associatedGuid = (item != nil && [item text] != nil)
+                ? [NSString stringWithFormat:@"p:%@/%@", data[@"partIndex"], [message guid]]
+                : [NSString stringWithFormat:@"bp:%@", [message guid]];
+            NSRange range = (item != nil) ? [item messagePartRange] : NSMakeRange(0, text.string.length);
+            NSDictionary *messageSummary = text.string != nil ? @{@"amc":@1,@"ams":text.string} : @{};
+            IMMessage *tapbackMessage = [tapback messageForChat:chat messageGUID:associatedGuid messagePartRange:range messageSummaryInfo:messageSummary threadIdentifier:nil];
+            [chat sendMessage:tapbackMessage];
+        }
+
+        if (transaction != nil) {
+            NSString *identifier = [[chat lastSentMessage] guid];
+            [[NetworkController sharedInstance] sendMessage: @{@"transactionId": transaction, @"identifier": identifier ?: @""}];
+        }
+    } @catch (NSException *exception) {
+        sendError([NSString stringWithFormat:@"Failed to send emoji tapback: %@", exception.reason]);
+    }
+}
